{
  "manifest_version": 3,
  "name": "Gemini Positivity Filter",
  "version": "1.0",
  "description": "Filters negative text on web pages using Gemini 1.5 Flash.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "asset/posstive-filter-png.png",
      "48": "asset/posstive-filter-png.png",
      "128": "asset/posstive-filter-png.png"
    }
  },
  "icons": {
    "16": "asset/posstive-filter-png.png",
    "48": "asset/posstive-filter-png.png",
    "128": "asset/posstive-filter-png.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["asset/posstive-filter-png.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}