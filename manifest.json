{
  "manifest_version": 3,
  "name": "ScrollClean",
  "version": "1.3",
  "description": "Securely filters negative text on web pages completely offline using Chrome's built-in Gemini Nano AI.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "report-toxic": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Report selected text or post as toxic"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "asset/watermarked_img_8969727160137344162.png",
      "48": "asset/watermarked_img_8969727160137344162.png",
      "128": "asset/watermarked_img_8969727160137344162.png"
    }
  },
  "icons": {
    "16": "asset/watermarked_img_8969727160137344162.png",
    "48": "asset/watermarked_img_8969727160137344162.png",
    "128": "asset/watermarked_img_8969727160137344162.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "asset/watermarked_img_8969727160137344162.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}